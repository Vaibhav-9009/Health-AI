# Copy this file to .env and fill in what you have.
# If OPENAI_API_KEY is left empty, the /api/query endpoint runs in
# MOCK MODE: it still returns a real, coherent answer (rule/template based)
# and a full evaluation matrix, so the demo never breaks without internet/keys.

# --- Groq (Recommended: 100% Free & Fast — get key at https://console.groq.com/keys) ---
# Paste your Groq key here (starts with gsk_):
GROQ_API_KEY=your_groq_api_key_here

# --- OpenAI (or any OpenAI-compatible provider) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Secret used to sign login session tokens. Change it to anything.
AUTH_SECRET=change-this-demo-secret

# Demo login credentials (single user, keep it simple)
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123
